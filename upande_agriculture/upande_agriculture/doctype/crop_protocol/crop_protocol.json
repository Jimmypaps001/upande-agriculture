{
 "actions": [],
 "autoname": "field:protocol_name",
 "naming_rule": "By fieldname",
 "creation": "2026-06-20 08:00:00",
 "doctype": "DocType",
 "engine": "InnoDB",
 "module": "Upande Agriculture",
 "name": "Crop Protocol",
 "owner": "Administrator",
 "description": "The growing recipe for one variety. Inputs only \u2014 every number here is something an agronomist knows, never something the system derives.",
 "field_order": [
  "protocol_name",
  "variety_item",
  "crop_type",
  "column_break_variety",
  "breeder",
  "reject_pct",
  "plants_per_sqm",
  "section_establishment",
  "weeks_to_first_bending",
  "weeks_to_second_bending",
  "column_break_establishment",
  "productive_life_years",
  "productive_life_weeks",
  "section_cycle",
  "weeks_between_cuts",
  "section_yield",
  "stems_per_plant_first_harvest",
  "stems_per_cut",
  "column_break_yield",
  "max_stems_per_plant_per_cut",
  "section_flush",
  "weeks_to_first_flush",
  "flush_interval_weeks",
  "column_break_flush",
  "total_flushes",
  "total_stems_per_plant_life",
  "flush_schedule",
  "section_grade_mix",
  "grade_mix",
  "section_growth_stages",
  "growth_stages"
 ],
 "fields": [
  {
   "fieldname": "protocol_name",
   "fieldtype": "Data",
   "label": "Protocol Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "variety_item",
   "fieldtype": "Link",
   "label": "Variety",
   "options": "Item",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Base variety (Athena), not a length grade (Athena-60cm) \u2014 the plant makes stems, grading splits them afterwards"
  },
  {
   "fieldname": "crop_type",
   "fieldtype": "Select",
   "label": "Crop Type",
   "options": "\nRose\nSpray Rose\nSummer Flower\nOther"
  },
  {
   "fieldname": "column_break_variety",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "breeder",
   "fieldtype": "Link",
   "label": "Breeder",
   "options": "Supplier",
   "in_list_view": 1
  },
  {
   "fieldname": "reject_pct",
   "fieldtype": "Percent",
   "label": "Expected Reject %",
   "description": "Share of cut stems that fail grading"
  },
  {
   "fieldname": "plants_per_sqm",
   "fieldtype": "Float",
   "label": "Plants Per Sqm",
   "description": "Standard planting density for this variety. Crop Cycle defaults to it and lets a grower override for an odd bed."
  },
  {
   "fieldname": "section_establishment",
   "fieldtype": "Section Break",
   "label": "Establishment",
   "description": "Bending applies to roses only; productive life applies to any crop type."
  },
  {
   "fieldname": "weeks_to_first_bending",
   "fieldtype": "Int",
   "label": "Weeks to First Bending",
   "description": "Planting to primary bend \u2014 builds the framework",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "weeks_to_second_bending",
   "fieldtype": "Int",
   "label": "Weeks to Second Bending",
   "description": "Weeks after the first bend. Production is counted from here.",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "column_break_establishment",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "productive_life_years",
   "fieldtype": "Float",
   "label": "Productive Life (Years)",
   "description": "How many years this variety stays in the ground. Drives the multi-year budget."
  },
  {
   "fieldname": "productive_life_weeks",
   "fieldtype": "Int",
   "label": "Productive Life (Weeks)",
   "description": "Derived from the years above",
   "read_only": 1
  },
  {
   "fieldname": "section_cycle",
   "fieldtype": "Section Break",
   "label": "Cut to Cut Cycle",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "weeks_between_cuts",
   "fieldtype": "Int",
   "label": "Cut to Cut Cycle (Weeks)",
   "description": "Regrowth period: a cut stem back to harvestable",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\"",
   "mandatory_depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "section_yield",
   "fieldtype": "Section Break",
   "label": "Yield",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "stems_per_plant_first_harvest",
   "fieldtype": "Float",
   "label": "Stems Per Plant, First Harvest",
   "description": "The first wave off a newly bent plant",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "stems_per_cut",
   "fieldtype": "Float",
   "label": "Stems Per Cut",
   "default": "1.5",
   "description": "Harvestable stems returned per stem cut. Breaks are 2-3; only the ones making grade are counted here.",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "column_break_yield",
   "fieldtype": "Column Break",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "max_stems_per_plant_per_cut",
   "fieldtype": "Float",
   "label": "Max Stems Per Plant Per Cut",
   "description": "Canopy ceiling. Without it the multiplier compounds forever.",
   "depends_on": "eval:doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "section_flush",
   "fieldtype": "Section Break",
   "label": "Flush Cycle",
   "depends_on": "eval:doc.crop_type==\"Summer Flower\" || doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\"",
   "description": "A summer flower doesn't compound off a cut stem \u2014 it flushes on a schedule that repeats every year. List each flush once; the pattern is replayed for the whole productive life."
  },
  {
   "fieldname": "weeks_to_first_flush",
   "fieldtype": "Int",
   "label": "Weeks to First Flush",
   "depends_on": "eval:doc.crop_type==\"Summer Flower\"",
   "description": "Planting to the first pick."
  },
  {
   "fieldname": "flush_interval_weeks",
   "fieldtype": "Int",
   "label": "Flush Interval Weeks",
   "depends_on": "eval:doc.crop_type==\"Summer Flower\"",
   "description": "Nominal spacing between flushes \u2014 used to fill in a blank offset below."
  },
  {
   "fieldname": "column_break_flush",
   "fieldtype": "Column Break",
   "depends_on": "eval:doc.crop_type==\"Summer Flower\""
  },
  {
   "fieldname": "total_flushes",
   "fieldtype": "Int",
   "label": "Total Flushes",
   "read_only": 1,
   "depends_on": "eval:doc.crop_type==\"Summer Flower\""
  },
  {
   "fieldname": "total_stems_per_plant_life",
   "fieldtype": "Float",
   "label": "Total Stems Per Plant (One Year's Pattern)",
   "read_only": 1,
   "depends_on": "eval:doc.crop_type==\"Summer Flower\""
  },
  {
   "fieldname": "flush_schedule",
   "fieldtype": "Table",
   "label": "Flush Schedule",
   "options": "Crop Protocol Flush",
   "depends_on": "eval:doc.crop_type==\"Summer Flower\" || doc.crop_type==\"Rose\" || doc.crop_type==\"Spray Rose\""
  },
  {
   "fieldname": "section_grade_mix",
   "fieldtype": "Section Break",
   "label": "Grade Mix",
   "description": "How a plant's stems split by length. Seeded from actual harvest - see Calibrate."
  },
  {
   "fieldname": "grade_mix",
   "fieldtype": "Table",
   "label": "Grade Mix",
   "options": "Crop Protocol Grade Mix"
  },
  {
   "fieldname": "section_growth_stages",
   "fieldtype": "Section Break",
   "label": "Growth Stages",
   "collapsible": 1,
   "description": "Stages offered when scouts sample a bed"
  },
  {
   "fieldname": "growth_stages",
   "fieldtype": "Table",
   "label": "Growth Stages",
   "options": "Crop Protocol Growth Stage"
  }
 ],
 "modified": "2026-07-26 00:00:00",
 "modified_by": "Administrator",
 "permissions": [
