 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "CC-.YYYY.-.####",
   "default": "CC-.YYYY.-.####",
   "hidden": 1
  },
  {
   "fieldname": "greenhouse",
   "fieldtype": "Link",
   "label": "Greenhouse",
   "options": "Warehouse",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "farm",
   "fieldtype": "Link",
   "label": "Farm",
   "options": "Farm",
   "read_only": 1,
   "fetch_from": "greenhouse.custom_farm",
   "fetch_if_empty": 1,
   "description": "Fetched from the greenhouse. Frappe's own User Permission on Farm restricts who can see this Crop Cycle — no extra code needed."
  },
  {
   "fieldname": "variety",
   "fieldtype": "Link",
   "label": "Variety",
   "options": "Item",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Base variety (Athena), not a length grade"
  },
  {
   "fieldname": "crop_protocol",
   "fieldtype": "Link",
   "label": "Crop Protocol",
   "options": "Crop Protocol",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_head",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "crop_type",
   "fieldtype": "Select",
   "label": "Crop Type",
   "options": "Production\nMotherstock\nTrial",
   "default": "Production"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Planned\nActive\nEnded",
   "default": "Active",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "section_timeline",
   "fieldtype": "Section Break",
   "label": "Timeline"
  },
  {
   "fieldname": "planting_date",
   "fieldtype": "Date",
   "label": "Planting Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "first_bending_date",
   "fieldtype": "Date",
   "label": "First Bending Date",
   "description": "Left empty, derived from the protocol"
  },
  {
   "fieldname": "second_bending_date",
   "fieldtype": "Date",
   "label": "Second Bending Date",
   "description": "Production is counted from here"
  },
  {
   "fieldname": "actual_first_bending_date",
   "fieldtype": "Date",
   "label": "Actual First Bending Date",
   "description": "Recorded once it actually happened. Overrides the planned date above."
  },
  {
   "fieldname": "actual_second_bending_date",
   "fieldtype": "Date",
   "label": "Actual Second Bending Date",
   "description": "Recorded once it actually happened. Overrides the planned date above."
  },
  {
   "fieldname": "column_break_timeline",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "planned_uprooting_date",
   "fieldtype": "Date",
   "label": "Planned Uprooting Date"
  },
  {
   "fieldname": "cycle_end_date",
   "fieldtype": "Date",
   "label": "Cycle End Date",
   "description": "Actual uprooting. Empty means the cycle is still running."
  },
  {
   "fieldname": "replaces",
   "fieldtype": "Link",
   "label": "Replaces",
   "options": "Crop Cycle",
   "description": "The block this planting replaced. Filled by Replant."
  },
  {
   "fieldname": "section_planting",
   "fieldtype": "Section Break",
   "label": "Planting"
  },
  {
   "fieldname": "qty_planted",
   "fieldtype": "Int",
   "label": "Plants Planted",
   "in_list_view": 1
  },
  {
   "fieldname": "plants_standing",
   "fieldtype": "Int",
   "label": "Plants Standing",
   "read_only": 1,
   "description": "Plants Planted minus everything logged as uprooted below."
  },
  {
   "fieldname": "plants_per_sqm",
   "fieldtype": "Float",
   "label": "Plants Per Sqm",
   "fetch_from": "crop_protocol.plants_per_sqm",
   "fetch_if_empty": 1
  },
  {
   "fieldname": "column_break_planting",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "planted_area",
   "fieldtype": "Float",
   "label": "Planted Area (m²)",
   "read_only": 1,
   "description": "Summed from the beds below"
  },
  {
   "fieldname": "implied_plants",
   "fieldtype": "Int",
   "label": "Implied Plants",
   "read_only": 1,
   "description": "Area × density. Checked against Plants Planted on save."
  },
  {
   "fieldname": "section_uprooting",
   "fieldtype": "Section Break",
   "label": "Uprooting",
   "collapsible": 1
  },
  {
   "fieldname": "uproot_log",
   "fieldtype": "Table",
   "label": "Uprooting Log",
   "options": "Crop Cycle Uproot"
  },
  {
   "fieldname": "section_beds",
   "fieldtype": "Section Break",
   "label": "Beds"
  },
  {
   "fieldname": "bed_range",
   "fieldtype": "Data",
   "label": "Beds",
   "description": "Type the beds: <b>1-50</b>, or <b>1-20, 31-40</b> for split blocks. The table below fills itself on save."
  },
  {
   "fieldname": "beds",
   "fieldtype": "Table",
   "label": "Beds",
   "options": "Crop Cycle Bed",
   "read_only_depends_on": "eval:!!doc.bed_range",
   "description": "Filled from the range above. Clear the range to edit by hand."
  },
  {
   "fieldname": "section_source",
   "fieldtype": "Section Break",
   "label": "Source & Cost",
   "collapsible": 1
  },
  {
   "fieldname": "purchase_invoice",
   "fieldtype": "Link",
   "label": "Purchase Invoice",
   "options": "Purchase Invoice",
   "depends_on": "eval:doc.seedling_source==\"Purchased from Breeder\" || doc.seedling_source==\"Mixed\"",
   "description": "Link the seedling invoice and the breeder and cost fill themselves. Leave blank to type them."
  },
  {
   "fieldname": "seedling_source",
   "fieldtype": "Select",
   "label": "Seedling Source",
   "options": "\nPurchased from Breeder\nIn-house Propagation\nMixed",
   "read_only_depends_on": "eval:!!doc.purchase_invoice"
  },
  {
   "fieldname": "breeder",
   "fieldtype": "Link",
   "label": "Breeder",
   "options": "Supplier",
   "read_only_depends_on": "eval:!!doc.purchase_invoice"
  },
  {
   "fieldname": "column_break_source",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "propagation_batch",
   "fieldtype": "Data",
   "label": "Propagation Batch",
   "depends_on": "eval:doc.seedling_source==\"In-house Propagation\" || doc.seedling_source==\"Mixed\""
  },
  {
   "fieldname": "cost_per_plant",
   "fieldtype": "Currency",
   "label": "Cost Per Plant",
   "read_only_depends_on": "eval:!!doc.purchase_invoice"
  },
  {
   "fieldname": "invoiced_qty",
   "fieldtype": "Int",
   "label": "Invoiced Qty",
   "read_only": 1,
   "depends_on": "purchase_invoice",
   "description": "Plants billed on the invoice — compared with Plants Planted"
  },
  {
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes",
   "collapsible": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  }
 ],
