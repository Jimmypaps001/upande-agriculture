  "charts": [],
  "content": "[{\"id\": \"agri_header\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\">Agriculture</span>\", \"col\": 12}}, {\"id\": \"agri_sc_proto\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Crop Protocols\", \"col\": 3}}, {\"id\": \"agri_sc_cycle\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Greenhouses\", \"col\": 3}}, {\"id\": \"agri_sc_trial\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Flower Trials\", \"col\": 3}}, {\"id\": \"agri_sc_budget\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Budget\", \"col\": 3}}, {\"id\": \"agri_sc_forecast\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Forecast\", \"col\": 3}}, {\"id\": \"agri_sc_plans\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Plans\", \"col\": 3}}, {\"id\": \"agri_planning_header\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h5\\\">How these fit together</span>\", \"col\": 12}}, {\"id\": \"agri_planning_para\", \"type\": \"paragraph\", \"data\": {\"text\": \"<b>Crop Protocol</b> defines what a variety should produce. <b>Greenhouse</b> holds the succession of crop cycles planted in a house \u2014 one row per plant life, from planting to uprooting. <b>Budget</b> is the annual 52-week projection per variety per greenhouse. <b>Forecast</b> revises the budget for the next few weeks. <b>Plan</b> is the supervisor weekly commitment plus tasks. <b>Flower Trial</b> evaluates a new variety before promoting it into a greenhouse crop cycle.\", \"col\": 12}}]",
